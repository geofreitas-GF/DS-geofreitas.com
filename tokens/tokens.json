    "btn-fs-sm": "fs-12", "btn-fs-md": "fs-13", "btn-fs-lg": "fs-14", "btn-track": "0.01em",
    "control-h": "40px", "control-px": "14px", "control-py-multiline": "10px",
    "icon-btn": "40px", "touch-min": "44px", "tag-h": "24px", "tag-px": "8px",
    "avatar-sm": "32px", "avatar-md": "40px", "avatar-lg": "48px",
    "switch-w": "44px", "switch-h": "24px", "check": "20px",
    "nav-h": "72px", "sticky-top": "96px", "dialog-w": "520px",
    "dur-fast": "150ms", "dur-base": "180ms", "dur-draw": "260ms", "dur-slow": "300ms",
    "ease-out": "ease-out", "ease-draw": "cubic-bezier(0.22, 1, 0.36, 1)",
    "max-width": "1200px", "gutter": "24px", "gutter-mobile": "16px", "section-gap": "space-64", "columns": "12",
    "breakpoints": { "sm": "600px", "md": "820px", "lg": "1024px", "xl": "1440px" }
  }
