      "h4":      { "size": "fs-22", "line": "1.25", "track": "0", "weight": "fw-semibold" },
      "body-lg": { "size": "fs-18", "line": "1.6",  "track": "0", "weight": "400" },
      "body":    { "size": "fs-16", "line": "1.55", "track": "0", "weight": "400" },
      "ui":      { "size": "fs-14", "line": "1.43", "track": "0", "weight": "500" },
      "caption": { "size": "fs-12", "line": "1.33", "track": "0", "weight": "400" },
      "eyebrow": { "size": "fs-12", "line": "1.33", "track": "0.08em", "weight": "600" }
    },
    "measure": "68ch",
    "space-4": "4px", "space-8": "8px", "space-12": "12px", "space-16": "16px", "space-24": "24px", "space-32": "32px", "space-48": "48px", "space-64": "64px",
    "radius-tag": "4px", "radius-control": "8px", "radius-card": "8px", "radius-panel": "12px", "radius-pill": "9999px",
