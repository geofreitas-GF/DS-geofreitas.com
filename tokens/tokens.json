    "warning-border": { "light": "#fddc69", "dark": "#5b4920" },
    "error-bg": { "light": "#fff1f1", "dark": "#32191a" },
    "error-border": { "light": "#ffb3b8", "dark": "#5b3231" },
    "error-solid": { "light": "#ff4d4f", "dark": "#dc6966", "note": "Invalid-field border only (3.3:1 / 5.5:1). Never text." },
    "status-fg": { "light": "#161616", "dark": "#ffffff" },
    "focus-ring": { "light": "#303030", "dark": "#fefa54" },
