    "secondary-border-hover": { "light": "#303030", "dark": "#ffffff" },
    "secondary-bg-pressed": { "light": "#eceef2", "dark": "#272727" },
    "link-fg": { "light": "#161616", "dark": "#ffffff", "protected": true },
    "link-underline": { "light": "#161616", "dark": "#ffffff", "protected": true },
    "tag-bg": { "light": "#f5f5f5", "dark": "#262626" },
