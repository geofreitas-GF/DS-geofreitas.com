{
  "$schema": "DS-geofreitas.com tokens v1.0 — hand-owned source of truth. Each key maps to --gf-<key> in variables.css. Themed values: { light, dark }.",
  "meta": { "name": "DS-geofreitas.com", "version": "1.0.0", "prefix": "gf",
            "lineage": "Carbon structure · Apple clarity · Material/antd token roles · Airbnb patterns (patterns only)",
            "theming": "Light default; follows prefers-color-scheme; force with data-theme=\"light\"|\"dark\"." },
  "themed": {
    "bg-canvas": { "light": "#ffffff", "dark": "#141414" },
    "bg-layer-1": { "light": "#f6f7f9", "dark": "#1d1d1d" },
    "bg-layer-2": { "light": "#eceef2", "dark": "#272727" },
