    "text-primary": { "light": "#161616", "dark": "#ffffff" },
    "text-secondary": { "light": "#525252", "dark": "#adadad" },
    "text-tertiary": { "light": "#6f6f6f", "dark": "#999999" },
    "border-subtle": { "light": "#e2e5ec", "dark": "#303030" },
    "border-strong": { "light": "#dbdcdc", "dark": "#3e3e3e" },
